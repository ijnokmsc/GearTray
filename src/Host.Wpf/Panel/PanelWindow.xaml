<Window x:Class="GearTray.Host.Panel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GearTray"
        Width="450"
        Height="820"
        MinWidth="360"
        MinHeight="380"
        Background="{DynamicResource Skin.Brush.WindowBackground}"
        FontFamily="{DynamicResource Skin.FontFamily}"
        WindowStartupLocation="CenterScreen">
    <!-- M1.5：颜色/字号/间距全部走 Skin.* Token，切肤靠 DynamicResource 重新求值，
         不重建任何控件（重建控件树会把进程搞崩，见 ApplySettings 的注释）。
         ComboBox 下拉模板只做了最小样式，完整模板化留到后续。 -->
    <Window.Resources>
        <!-- 自定义 ComboBox 模板里 SelectionBoxItemTemplate 取自 ItemTemplate，
             不会从 DisplayMemberPath 自动生成 —— 所以显示项文字必须用显式 DataTemplate，
             否则下拉框里显示的是 "DeviceSettingOption" 这种类型名。 -->
        <DataTemplate x:Key="OptionLabelTemplate">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="SkinNameTemplate">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <!-- 必须自带 ComboBox 模板：Aero2 的默认模板不认 Background，
             皮肤设了也是白设（实测深色皮肤下面板里仍是 #E9E9E9 的白框）。 -->
        <ControlTemplate x:Key="SkinComboTemplate" TargetType="ComboBox">
            <Grid>
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Skin.CornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                        <Path Grid.Column="1"
                              Data="M 0 0 L 4 4 L 8 0"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ToggleButton Focusable="False"
                              ClickMode="Press"
                              Background="Transparent"
                              BorderThickness="0"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Popup AllowsTransparency="True"
                       Placement="Bottom"
                       Focusable="False"
                       PopupAnimation="Fade"
                       IsOpen="{TemplateBinding IsDropDownOpen}">
                    <Border Background="{DynamicResource Skin.Brush.ControlBackground}"
                            BorderBrush="{DynamicResource Skin.Brush.ControlBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Skin.CornerRadius}"
                            MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="SkinCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Skin.Brush.ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Skin.Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Skin.Brush.ControlBorder}" />
            <Setter Property="FontSize" Value="{DynamicResource Skin.FontSize.Base}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template" Value="{StaticResource SkinComboTemplate}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource Skin.Brush.ControlBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource Skin.Brush.TextPrimary}" />
                        <Setter Property="Padding" Value="8,3" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkinButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Skin.Brush.ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Skin.Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Skin.Brush.ControlBorder}" />
            <Setter Property="FontSize" Value="{DynamicResource Skin.FontSize.Base}" />
            <Setter Property="Padding" Value="14,5" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Skin.FontSize.Base}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Skin.Brush.TextSecondary}" />
        </Style>

        <Style x:Key="HairLine" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource Skin.Brush.Border}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="设备电量"
                       FontSize="{DynamicResource Skin.FontSize.Heading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Skin.Brush.TextPrimary}"
                       VerticalAlignment="Center" />

            <TextBlock x:Name="SummaryText"
                       Grid.Column="1"
                       Margin="12,0,0,0"
                       FontSize="{DynamicResource Skin.FontSize.Caption}"
                       Foreground="{DynamicResource Skin.Brush.TextSecondary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <ComboBox x:Name="SkinPicker"
                      Grid.Column="2"
                      Width="112"
                      Style="{StaticResource SkinCombo}"
                      VerticalAlignment="Center"
                      ToolTip="切换皮肤：只替换 Token，不重建控件"
                      SelectionChanged="OnSkinChanged" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource Skin.Brush.Border}"
                                    Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{DynamicResource Skin.FontSize.Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Skin.Brush.TextPrimary}" />
                                        <!-- 必须裁剪：详情行比列宽长，不裁会直接压到右边的电量数字上。 -->
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="{DynamicResource Skin.FontSize.Caption}"
                                                   Foreground="{DynamicResource Skin.Brush.TextSecondary}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BatteryText}"
                                               FontSize="{DynamicResource Skin.FontSize.Display}"
                                               Foreground="{DynamicResource Skin.Brush.TextPrimary}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="DpiRow"
                        Style="{StaticResource HairLine}"
                        Padding="0,12,0,0"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="DpiTitle" Text="DPI 档位" Style="{StaticResource SectionTitle}" />
                        <WrapPanel x:Name="DpiPanel" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Win 锁是键盘固件的一个字段，放进同一个「键盘设置」块里，
                     不单独占一段，否则同一台键盘被切成两块。 -->
                <Border x:Name="SettingsRow"
                        Style="{StaticResource HairLine}"
                        Padding="0,12,0,8"
                        Margin="0,8,0,8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="SettingsTitle"
                                       DockPanel.Dock="Left"
                                       Text="键盘设置"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="SettingsStatus"
                                       HorizontalAlignment="Right"
                                       FontSize="{DynamicResource Skin.FontSize.Caption}"
                                       Foreground="{DynamicResource Skin.Brush.TextTertiary}"
                                       Text="写入固件"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <Border x:Name="WinLockRow"
                                Padding="0,6,0,0"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Win 键锁"
                                           Width="120"
                                           FontSize="{DynamicResource Skin.FontSize.Base}"
                                           Foreground="{DynamicResource Skin.Brush.TextPrimary}"
                                           VerticalAlignment="Center"
                                           ToolTip="键盘固件位，锁定后 Win 键由键盘自己屏蔽" />
                                <CheckBox x:Name="WinLockCheck"
                                          Foreground="{DynamicResource Skin.Brush.TextPrimary}"
                                          VerticalAlignment="Center"
                                          Click="OnWinLockClick" />
                                <TextBlock x:Name="WinLockHint"
                                           Margin="8,0,0,0"
                                           FontSize="{DynamicResource Skin.FontSize.Caption}"
                                           Foreground="{DynamicResource Skin.Brush.TextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="SettingsPanel" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="立即刷新" Style="{StaticResource SkinButton}" Click="OnRefreshClick" Margin="0,0,8,0" />
            <Button Content="退出" Style="{StaticResource SkinButton}" Click="OnExitClick" />
        </StackPanel>
    </Grid>
</Window>
